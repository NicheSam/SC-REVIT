{
  "version": "0.3-prep",
  "principle": "frontstage workflows stay independent; backstage batch/result management is shared through core only",
  "modules": {
    "family_library": {
      "path": "sc_revit/family_library",
      "legacy_files": ["classifier.py", "naming_rules.py", "ingest_service.py", "library_index.py", "library_validator.py", "duplicate_checker.py", "rfa_reader.py", "workflow.py"],
      "actions": ["scan_project_families", "export_project_families", "add_missing_string_parameters", "set_string_parameter_values"]
    },
    "cad_points": {
      "path": "sc_revit/cad_points",
      "legacy_files": ["point_placement_client.py", "dwg_block_reader.py"],
      "actions": ["list_point_placement_context", "list_cad_block_names", "scan_cad_block_points", "transform_dwg_block_points", "create_dwg_preview_markers", "place_cad_block_points", "place_dwg_block_points"]
    },
    "openings": {
      "path": "sc_revit/openings",
      "legacy_files": ["opening_check_client.py", "xlsx_exporter.py"],
      "actions": ["list_opening_context", "scan_opening_candidates", "view_opening_candidate", "place_opening_markers"]
    },
    "fire_branch": {
      "path": "sc_revit/fire_branch",
      "legacy_files": ["point_placement_client.py"],
      "actions": ["list_fire_branch_context", "read_fire_branch_selection", "create_fire_branch_preview", "create_fire_branch_pipes"]
    },
    "project_recovery": {
      "path": "sc_revit/project_recovery",
      "legacy_files": ["project_family_scanner.py"],
      "actions": ["scan_project_families", "export_project_families"]
    },
    "parameters": {
      "path": "sc_revit/parameters",
      "legacy_files": ["parameter_standardizer.py", "parameter_values.py", "parameter_writer.py"],
      "actions": ["add_missing_string_parameters", "set_string_parameter_values"]
    }
  }
}
